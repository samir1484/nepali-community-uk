// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  USER
  MODERATOR
  ADMIN
}

enum UserType {
  STUDENT
  EMPLOYEE
  EMPLOYER
  LANDLORD
  TENANT
  BUSINESS_OWNER
  VOLUNTEER
  OTHER
}

enum Interest {
  JOBS
  EVENTS
  ROOMS
  BLOGS
  NEWS
  HOUSING
  BUSINESS
  EDUCATION
  FESTIVALS
  TECHNOLOGY
  HEALTH
  SPORTS
  IMMIGRATION
}

model User {
  id            String    @id @default(cuid())
  name          String
  email         String    @unique
  passwordHash  String?
  phone         String?
  address       String?
  location      String?
  occupation    String?
  userType      UserType  @default(OTHER)
  interests     Interest[]
  image         String?
  role          Role      @default(USER)
  emailVerified DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  accounts          Account[]
  sessions          Session[]
  listings          Listing[]
  notificationLogs  NotificationLog[]
  articles          Article[]
  gameScores        GameScore[]

  @@map("users")
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@map("accounts")
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("sessions")
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
  @@map("verification_tokens")
}

model SiteSetting {
  key       String   @id
  value     Json
  updatedAt DateTime @updatedAt

  @@map("site_settings")
}

enum SectionType {
  HIGHLIGHT
  SHOWCASE
}

model HomeSection {
  id        String      @id @default(cuid())
  type      SectionType
  title     String
  caption   String?
  imageUrl  String?
  linkUrl   String?
  order     Int         @default(0)
  isActive  Boolean     @default(true)
  createdAt DateTime    @default(now())
  updatedAt DateTime    @updatedAt

  @@index([type, isActive, order])
  @@map("home_sections")
}

enum ListingType {
  JOB
  ROOM
  EVENT
  VOLUNTEER
  BUSINESS
}

enum ModerationStatus {
  PENDING
  APPROVED
  REJECTED
}

model Listing {
  id          String           @id @default(cuid())
  type        ListingType
  title       String
  description String
  location    String
  status      ModerationStatus @default(PENDING)
  details     Json             @default("{}")
  images      String[]         @default([])
  externalUrl String?
  whatsapp    String?
  authorId    String
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt

  author            User              @relation(fields: [authorId], references: [id], onDelete: Cascade)
  notificationLogs  NotificationLog[]
  contactMessages   ContactMessage[]

  @@index([type, status, location])
  @@map("listings")
}

model NotificationLog {
  id        String   @id @default(cuid())
  listingId String
  userId    String
  sentAt    DateTime @default(now())

  listing Listing @relation(fields: [listingId], references: [id], onDelete: Cascade)
  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([listingId, userId])
  @@map("notification_logs")
}

enum ArticleStatus {
  DRAFT
  PUBLISHED
}

enum ArticleCategory {
  NEWS
  BLOG
  IMMIGRATION
  STUDENT
}

/** Where an advert block renders. Adding a value here needs a matching <AdSlot> on that page. */
enum AdPlacement {
  HOMEPAGE
  JOBS
  ROOMS
  EVENTS
  BUSINESSES
  NEWS
}

model Advert {
  id          String        @id @default(cuid())
  /** One advert can run in several places at once, so this is a list. */
  placements  AdPlacement[]
  title       String
  body        String?
  imageUrl    String?
  linkUrl     String?
  isActive    Boolean       @default(true)
  order       Int           @default(0)
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  @@index([isActive, order])
  @@map("adverts")
}

model Article {
  id          String          @id @default(cuid())
  slug        String          @unique
  title       String
  excerpt     String
  content     String
  category    ArticleCategory @default(NEWS)
  coverImage  String?
  externalUrl String?
  status      ArticleStatus   @default(DRAFT)
  publishedAt DateTime?
  authorId    String?
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt

  author User? @relation(fields: [authorId], references: [id], onDelete: SetNull)

  @@index([status, publishedAt])
  @@map("articles")
}

model GameScore {
  id        String   @id @default(cuid())
  game      String   @default("BAGH_CHAL")
  side      String   @default("GOAT")
  userId    String
  score     Int
  won       Boolean  @default(false)
  drawn     Boolean  @default(false)
  tigersTrapped  Int @default(0)
  goatsRemaining Int @default(0)
  goatsCaptured  Int @default(0)
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([game, score])
  @@index([userId])
  @@map("game_scores")
}

/** Backs the fixed-window rate limiter on public API routes. */
model RateLimitEvent {
  id        String   @id @default(cuid())
  bucketKey String
  createdAt DateTime @default(now())

  @@index([bucketKey, createdAt])
  @@map("rate_limit_events")
}

enum ContactSource {
  CONTACT_FORM
  LISTING_INQUIRY
  ADVERTISING
}

model ContactMessage {
  id          String        @id @default(cuid())
  source      ContactSource
  name        String
  email       String
  messageBody String
  listingId   String?
  notes       String?
  followUpAt  DateTime?
  createdAt   DateTime      @default(now())

  listing Listing? @relation(fields: [listingId], references: [id], onDelete: SetNull)

  @@index([source, createdAt])
  @@map("contact_messages")
}

model SocialLink {
  id        String   @id @default(cuid())
  platform  String
  url       String
  order     Int      @default(0)
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([isActive, order])
  @@map("social_links")
}
